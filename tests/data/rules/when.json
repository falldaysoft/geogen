{
 "name": "when",
 "about": "An interaction's `when`: nobody can use the hatch until the power is on, and only someone carrying the key may use the vault; rules drive both whatever their conditions say.",
 "program": {
  "format": "geogen-rules",
  "version": 1,
  "variables": {
   "world:demo.power": {
    "type": "bool",
    "default": false
   },
   "actor:demo.has_key": {
    "type": "bool",
    "default": false
   }
  },
  "interactions": {
   "demo:hatch#lid": {
    "initial": "shut",
    "duration": 0.5,
    "when": {
     "get": "world",
     "name": "power",
     "package": "demo"
    },
    "states": {
     "shut": {
      "next": "open"
     },
     "open": {
      "next": "shut"
     }
    }
   },
   "demo:vault#door": {
    "initial": "shut",
    "duration": 0.5,
    "when": {
     "get": "actor",
     "name": "has_key",
     "package": "demo"
    },
    "states": {
     "shut": {
      "next": "open"
     },
     "open": {
      "next": "shut"
     }
    }
   }
  },
  "rules": [
   {
    "id": "blackout_opens",
    "on": {
     "type": "changed",
     "key": "world:demo.power",
     "to": false
    },
    "do": [
     {
      "set": "demo:hatch#lid",
      "to": "open"
     }
    ]
   }
  ]
 },
 "actors": {
  "player": {
   "kind": "player"
  },
  "npc:guard": {
   "kind": "npc"
  }
 },
 "steps": [
  {
   "use": "demo:hatch#lid",
   "actor": "player",
   "used": false
  },
  {
   "expect": {
    "state": {
     "demo:hatch#lid": "shut"
    },
    "signals": [],
    "fired": []
   }
  },
  {
   "set": "world:demo.power",
   "to": true
  },
  {
   "use": "demo:hatch#lid",
   "actor": "player",
   "used": true
  },
  {
   "advance": 0.6
  },
  {
   "expect": {
    "state": {
     "demo:hatch#lid": "open"
    }
   }
  },
  {
   "use": "demo:hatch#lid",
   "actor": "player",
   "used": true
  },
  {
   "advance": 0.6
  },
  {
   "set": "world:demo.power",
   "to": false
  },
  {
   "expect": {
    "state": {
     "demo:hatch#lid": "open"
    },
    "fired": [
     "blackout_opens"
    ]
   }
  },
  {
   "set": "actor:demo.has_key",
   "to": true,
   "actor": "npc:guard"
  },
  {
   "use": "demo:vault#door",
   "actor": "player",
   "used": false
  },
  {
   "use": "demo:vault#door",
   "actor": "npc:guard",
   "used": true
  },
  {
   "advance": 0.6
  },
  {
   "expect": {
    "state": {
     "demo:vault#door": "open"
    },
    "errors": 0
   }
  }
 ]
}
