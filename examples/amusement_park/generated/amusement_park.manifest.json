      }
    },
    "inputs": {
      "amusement_park:zoo#start": {
        "set": "amusement_park:zoo#running",
        "to": true
      },
      "amusement_park:zoo#stop": {
        "set": "amusement_park:zoo#running",
        "to": false
      },
      "amusement_park:zoo#emit": {
        "set": "amusement_park:zoo#queued",
        "to": {
          "op": "+",
          "args": [
            {
              "get": "instance",
              "id": "amusement_park:zoo",
              "name": "queued"
            },
            1
          ]
        }
      },
      "amusement_park:zoo#reset": {
        "set": "amusement_park:zoo#restarts",
        "to": {
          "op": "+",
          "args": [
            {
              "get": "instance",
              "id": "amusement_park:zoo",
              "name": "restarts"
            },
            1
          ]
        }
      }
    }
  },
  "rules": {
    "format": "geogen-rules",
    "version": 1,
    "package": "amusement_park",
    "bindings": [],
    "rules": [
      {
        "id": "welcome",
        "on": {
          "type": "start"
        },
        "do": [
          {
            "notify": "Welcome to the fair. Pull a ride's lever to start it, and get on."
          }
        ]
      }
    ]
  }
